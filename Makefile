# --no-sync, as in CI: `uv run --extra ...` would swap PyTorch to that extra's build.
RUN := uv run --no-sync

.PHONY: lint format format-and-lint eval migration

lint:
	$(RUN) ruff check
	$(RUN) ruff format --check
	$(RUN) ty check

format:
	$(RUN) ruff check --fix-only
	$(RUN) ruff format

format-and-lint:
	$(MAKE) format
	$(MAKE) lint

# Score retrieval on the real library (needs the database and embedding settings); not part of CI.
eval:
	$(RUN) alexandria-eval

# Write a migration autogenerated from the models: make migration m="add tags" writes 0004_add_tags.py.
# It compares against a throwaway Postgres container upgraded to head, never against your configured database.
PGVECTOR_IMAGE := pgvector/pgvector:0.8.7-pg17

migration:
	@test -n "$(m)" || { echo 'usage: make migration m="add tags"'; exit 2; }
	@container=$$(docker run -d --rm -e POSTGRES_PASSWORD=scratch -p 127.0.0.1::5432 $(PGVECTOR_IMAGE)) || exit 1; \
	trap "docker stop $$container >/dev/null" EXIT; \
	port=$$(docker port $$container 5432/tcp | head -n 1 | sed 's/.*://'); \
	export ALEXANDRIA_DATABASE_URL=postgresql+psycopg://postgres:scratch@127.0.0.1:$$port/postgres; \
	until docker exec $$container pg_isready -q -h 127.0.0.1 -U postgres; do sleep 1; done; \
	$(RUN) alexandria-db upgrade && $(RUN) alexandria-db revision --autogenerate -m "$(m)"
