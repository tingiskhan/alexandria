# Alexandria with Docker: copy to .env next to compose.yaml, fill in, then `docker compose up -d`.
# Every setting is described in https://github.com/tingiskhan/alexandria#configuration
# An empty value (KEY=) counts as unset.

# --- Deployment ---
# Required. Which worker runs: gpu (NVIDIA; needs the NVIDIA Container Toolkit) or cpu. Add ,rustfs to also run
# a local S3 store for trying Alexandria out (console: http://localhost:9001).
COMPOSE_PROFILES=gpu
# The image version; the release's compose.yaml defaults to its own version. Read the release notes before upgrading.
# ALEXANDRIA_VERSION=
# Required, secret. The password of the bundled Postgres. Avoid @ : / in it, since it becomes part of a URL.
POSTGRES_PASSWORD=

# --- Syncing ---
# Run a sync this often: seconds, or 30m, 1h, 1d. Empty means syncs only start from the Prefect UI.
ALEXANDRIA_SYNC_INTERVAL=1h
# File extensions to ingest, comma-separated. Add png,jpg,jpeg,tiff to OCR images.
# ALEXANDRIA_EXTRACT_FORMATS=pdf,docx,pptx,xlsx,html,htm,md,txt

# --- Source ---
# Required. s3, dropbox or sharepoint. Only that source's settings below are needed.
ALEXANDRIA_SOURCE_KIND=s3

# S3, RustFS, MinIO or AWS. These defaults match the bundled RustFS (profile rustfs).
ALEXANDRIA_S3_ENDPOINT_URL=http://rustfs:9000
ALEXANDRIA_S3_BUCKET=library
# ALEXANDRIA_S3_PREFIX=
ALEXANDRIA_S3_ACCESS_KEY_ID=alexandria
# Required, secret. With the bundled RustFS, also its admin password (at least 8 characters).
ALEXANDRIA_S3_SECRET_ACCESS_KEY=
# ALEXANDRIA_S3_REGION=us-east-1

# Dropbox. Get the refresh token with:
#   docker run --rm -it ghcr.io/tingiskhan/alexandria:latest-cpu alexandria-ingest auth --app-key <app key>
# ALEXANDRIA_DROPBOX_APP_KEY=
# ALEXANDRIA_DROPBOX_REFRESH_TOKEN=
# ALEXANDRIA_DROPBOX_PATH=

# SharePoint / OneDrive for Business: an Entra ID app with read access to the site; see the README.
# ALEXANDRIA_SHAREPOINT_TENANT_ID=
# ALEXANDRIA_SHAREPOINT_CLIENT_ID=
# ALEXANDRIA_SHAREPOINT_CLIENT_SECRET=
# ALEXANDRIA_SHAREPOINT_SITE=contoso.sharepoint.com:/sites/Finance
# ALEXANDRIA_SHAREPOINT_LIBRARY=Documents
# ALEXANDRIA_SHAREPOINT_DRIVE_ID=
# ALEXANDRIA_SHAREPOINT_PATH=

# --- Embedding (ingest and the MCP server must agree) ---
# ALEXANDRIA_EMBEDDING_MODEL=BAAI/bge-m3
# ALEXANDRIA_EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181
# ALEXANDRIA_EMBEDDING_BATCH_SIZE=32
# ALEXANDRIA_CHUNK_MAX_TOKENS=500
