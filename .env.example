# Copy to .env and fill in: cp .env.example .env
# Environment variables override .env; secrets can also be files in /run/secrets/<VARIABLE>.
# An empty value (KEY=) counts as unset.

# --- Postgres password ---
# Used by compose.yaml for its Postgres, and in ALEXANDRIA_DATABASE_URL below via ${POSTGRES_PASSWORD}.
# Avoid @ : / in it, or percent-encode them, since it becomes part of a URL.
# RustFS takes its keys from ALEXANDRIA_S3_ACCESS_KEY_ID and ALEXANDRIA_S3_SECRET_ACCESS_KEY below.
POSTGRES_PASSWORD=

# --- Database (DatabaseSettings, core) — used by workflows and MCP ---
# Required, secret. Postgres with the pgvector extension (>= 0.8). ${VAR} refers to a variable defined earlier in this
# file; it is expanded here only, not when the URL is set as an environment variable or in /run/secrets.
ALEXANDRIA_DATABASE_URL=postgresql+psycopg://alexandria:${POSTGRES_PASSWORD}@localhost:5432/alexandria

# --- Source (SourceSettings, ingest) — used by workflows ---
# Required. Where documents are synced from: s3 (RustFS, MinIO, AWS), dropbox or sharepoint. Only that source's settings below are needed.
ALEXANDRIA_SOURCE_KIND=s3

# --- S3 / RustFS (S3Settings, ingest sources/s3/) — when ALEXANDRIA_SOURCE_KIND=s3 ---
# The endpoint matches the RustFS service in compose.yaml (console: http://localhost:9001/rustfs/console/).
# The S3 API endpoint; leave empty for AWS.
ALEXANDRIA_S3_ENDPOINT_URL=http://localhost:9000
# Required. Create the bucket first, e.g. in the RustFS console.
ALEXANDRIA_S3_BUCKET=library
# Only sync keys under this prefix, e.g. papers/ ; empty means the whole bucket.
ALEXANDRIA_S3_PREFIX=
# Required. With compose, RustFS's admin user (also the console login); otherwise a key that can list and read the bucket.
ALEXANDRIA_S3_ACCESS_KEY_ID=alexandria
# Required, secret. With compose, the admin password; pick at least 8 characters.
ALEXANDRIA_S3_SECRET_ACCESS_KEY=
# ALEXANDRIA_S3_REGION=us-east-1

# --- Dropbox (DropboxSettings, ingest sources/dropbox/) — when ALEXANDRIA_SOURCE_KIND=dropbox ---
# Required. The key of your scoped Dropbox app.
# ALEXANDRIA_DROPBOX_APP_KEY=
# Required, secret, long-lived (valid until you revoke the app). Get it with: uv run alexandria-ingest auth --app-key <app key>
# ALEXANDRIA_DROPBOX_REFRESH_TOKEN=
# Folder to sync inside the app folder, starting with "/" (e.g. /papers); empty means the app folder root.
# ALEXANDRIA_DROPBOX_PATH=

# --- SharePoint / OneDrive for Business (SharePointSettings, ingest sources/sharepoint/) — when ALEXANDRIA_SOURCE_KIND=sharepoint ---
# An Entra ID app with read access to the site; see "SharePoint / OneDrive for Business / Teams" in the README.
# Required. The directory (tenant) id and the app's application (client) id.
# ALEXANDRIA_SHAREPOINT_TENANT_ID=
# ALEXANDRIA_SHAREPOINT_CLIENT_ID=
# Required, secret. A client secret of the app.
# ALEXANDRIA_SHAREPOINT_CLIENT_SECRET=
# The site, as host:/path; required unless ALEXANDRIA_SHAREPOINT_DRIVE_ID is set.
# ALEXANDRIA_SHAREPOINT_SITE=contoso.sharepoint.com:/sites/Finance
# The document library in the site; `alexandria-ingest sharepoint-libraries` lists them.
# ALEXANDRIA_SHAREPOINT_LIBRARY=Documents
# A drive id instead of site and library, e.g. a OneDrive for Business drive.
# ALEXANDRIA_SHAREPOINT_DRIVE_ID=
# Folder to sync, starting with "/" (e.g. /Reports); empty means the whole library.
# ALEXANDRIA_SHAREPOINT_PATH=

# --- Embedding (EmbeddingSettings, embed) — used by workflows and MCP ---
# Ingest and MCP must use the same model and revision. The model must have 1024 dimensions.
# ALEXANDRIA_EMBEDDING_MODEL=BAAI/bge-m3
# ALEXANDRIA_EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181
# ALEXANDRIA_EMBEDDING_BATCH_SIZE=32

# --- Chunking (ChunkSettings, ingest) — used by workflows ---
# ALEXANDRIA_CHUNK_MAX_TOKENS=500

# --- Extraction (ExtractSettings, ingest) — used by workflows ---
# File extensions to ingest, comma-separated; other files are skipped. Add png,jpg,jpeg,tiff to OCR images.
# Changing the list makes the next sync list the whole source once, to find files of newly added formats.
# ALEXANDRIA_EXTRACT_FORMATS=pdf,docx,pptx,xlsx,html,htm,md,txt

# --- Workflows (WorkflowSettings, workflows) — used by workflows ---
# Run sync this often: seconds, 30m, 1h, 1d or ISO 8601 (PT1H). Empty means runs only start from Prefect.
# ALEXANDRIA_SYNC_INTERVAL=

# --- MCP server over HTTP (McpSettings, mcp) — used by MCP with --transport streamable-http ---
# Where it listens. Keep 127.0.0.1 unless an authenticating proxy is in front; Docker sets 0.0.0.0 in the container.
# ALEXANDRIA_MCP_HOST=127.0.0.1
# ALEXANDRIA_MCP_PORT=8000
# Other names clients reach it by, comma-separated, e.g. your proxy's. Requests for any other name than localhost
# are refused, so a web page can't reach the server by DNS rebinding.
# ALEXANDRIA_MCP_ALLOWED_HOSTS=
